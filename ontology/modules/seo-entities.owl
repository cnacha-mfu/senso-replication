<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://senso-framework.org/ontology/seo/seo-entities"
         xmlns="http://senso-framework.org/ontology/seo/seo-entities#">

<owl:Ontology rdf:about="http://senso-framework.org/ontology/seo/seo-entities"/>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasVersion">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasModule">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Module"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasFile">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Module"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#File"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasFunction">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#File"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Function"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasDependency">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Module"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Dependency"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasMonth">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#MonthSnapshot"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#nextMonth">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#MonthSnapshot"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#MonthSnapshot"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasCommit">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Commit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasRelease">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Release"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasAuthor">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Commit"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Developer"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CodingAgent"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#modifiesFile">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Commit"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#File"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasParent">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#dependsOn">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Module"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#File"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Module"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#File"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Dependency"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:AnnotationProperty rdf:about="http://senso-framework.org/ontology/seo#explanationTemplate"/>

<owl:AnnotationProperty rdf:about="http://senso-framework.org/ontology/seo#thresholdId"/>

<owl:AnnotationProperty rdf:about="http://senso-framework.org/ontology/seo#thresholdSource"/>

<owl:AnnotationProperty rdf:about="http://senso-framework.org/ontology/seo#computedBy"/>

<owl:AnnotationProperty rdf:about="http://senso-framework.org/ontology/seo#measurementUnit"/>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject">
  <rdfs:comment xml:lang="en">Paper 1 — top-level entity representing a software project.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Version">
  <rdfs:comment xml:lang="en">Paper 1 — represents a point-in-time snapshot.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Module">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#File">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Function">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Dependency">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Developer">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Commit">
  <rdfs:comment xml:lang="en">Paper 1 — atomic change event.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Release">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#CodingAgent">
  <rdfs:comment xml:lang="en">Paper 1 — agent-aware extension.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#AgentCommit">
  <rdfs:comment xml:lang="en">Paper 1 - declared here, DEFINED in seo-inference.owl as the union of the evidence classes (trailer, bot author, branch). Never asserted.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#Commit"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#MonthSnapshot">
  <rdfs:comment xml:lang="en">Paper 1 WP1 - per-month measurement snapshot.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#AgentManifest">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#AgentGeneratedPR">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Version"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Module"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#File"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Function"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Dependency"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Developer"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Commit"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Release"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CodingAgent"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#AgentManifest"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#AgentGeneratedPR"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#MonthSnapshot"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
