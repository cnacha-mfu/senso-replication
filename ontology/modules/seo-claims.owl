        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_versionLowerDelta_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#VersionUpperCompatible"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#AgreeingVersionEvidence"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">claimed version lies within the declared range</seo:explanationTemplate>
