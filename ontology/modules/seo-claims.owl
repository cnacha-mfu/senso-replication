      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#SupportedClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no forbidden import in {importFilesScanned} scanned file(s)</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_forbiddenImportEdgeCount_gt_0">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#forbiddenImportEdgeCount"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minExclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{forbiddenImportEdgeCount} &gt; 0</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_forbiddenImportEdgeCount_lt_wp2_import_violation_min_edges">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#forbiddenImportEdgeCount"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:maxExclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{forbiddenImportEdgeCount} &lt; 1</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2_import_violation_min_edges</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/wp2-design.md section 3 (T7)</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ImportRuleModerate">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ImportConstraintClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_forbiddenImportEdgeCount_gt_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_forbiddenImportEdgeCount_lt_wp2_import_violation_min_edges"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#IndeterminateClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{forbiddenImportEdgeCount} forbidden import(s), below the violation threshold</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2_import_violation_min_edges</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/wp2-design.md section 3 (T7)</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_importFilesScanned_ge_0_le_0">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#importFilesScanned"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{importFilesScanned} within [0, 0]</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ImportScopeEmpty">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ImportConstraintClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_importFilesScanned_ge_0_le_0"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#UnverifiableClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no source file was found in the claim's scope</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#SupportedClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SupportedClaim: a claim in one of its leaf classes</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ContradictedClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ContradictedClaim: a claim in one of its leaf classes</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#UnverifiableClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnverifiableClaim: a claim in one of its leaf classes</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#IndeterminateClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IndeterminateClaim: a claim in one of its leaf classes</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ConflictedClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ConflictedClaim: a claim in one of its leaf classes</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ManifestWithContradiction">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ManifestDocument"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#makesClaim"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#ContradictedClaim"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the manifest makes at least one contradicted claim</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#DriftedClaim">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ContradictedClaim"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#introducedAs"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#SupportedClaim"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contradicted at the snapshot but supported when the claim text was introduced</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#BornWrongClaim">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ContradictedClaim"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#introducedAs"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#ContradictedClaim"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contradicted both at the snapshot and when the claim text was introduced</seo:explanationTemplate>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SupportedClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ContradictedClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#UnverifiableClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#IndeterminateClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ConflictedClaim"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#PathExistenceClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#PathStatusClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ToolUsageClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#DependencyClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CommandClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#VersionClaim"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ImportConstraintClaim"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
