  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ContradictedClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{claimSubject} is not tracked at the snapshot, not git-ignored, and no commit up to the snapshot ever touched it</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#StatusPathUnresolved">
