<owl:Class rdf:about="http://senso-framework.org/ontology/seo#PathRemoved">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#PathExistenceClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathExactMatchCount_ge_0_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathSuffixMatchCount_ge_0_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathIgnoredCount_ge_0_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathSubmoduleCount_ge_0_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathEverTrackedCount_ge_1"/>
