  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">claimed version is below the declared lower bound</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_versionUpperDelta_lt_0">
