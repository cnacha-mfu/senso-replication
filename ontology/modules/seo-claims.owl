  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{claimSubject} is not tracked at the snapshot and not git-ignored; {pathEverTrackedCount} earlier commit(s) touched it</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#PathNeverExisted">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim"/>
