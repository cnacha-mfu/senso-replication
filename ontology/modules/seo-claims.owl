  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no parseable version source exists for the claim's subject at the snapshot</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_forbiddenImportEdgeCount_ge_wp2_import_violation_min_edges">
