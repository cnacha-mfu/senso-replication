        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathSuffixMatchCount_ge_0_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathIgnoredCount_ge_0_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathSubmoduleCount_ge_0_le_0"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_pathEverTrackedCount_ge_0_le_0"/>
