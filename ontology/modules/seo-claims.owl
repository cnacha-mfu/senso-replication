  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">declared lower bound is below the claimed minimum</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_versionLowerDelta_gt_0">
