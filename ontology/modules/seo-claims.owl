  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">claimed version is above the declared upper bound</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#DisagreeingVersionEvidence">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#NonAgreeingVersionEvidence"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#NonDisagreeingVersionEvidence">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#VersionEvidence"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#NonAgreeingVersionEvidence">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#VersionEvidence"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#VersionConfirmed">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#VersionClaim"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasEvidence"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#AgreeingVersionEvidence"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasEvidence"/>
          <owl:allValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#NonDisagreeingVersionEvidence"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#SupportedClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every parseable source ({versionSourceCount}) agrees with the claimed version</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#VersionContradicted">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#VersionClaim"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasEvidence"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#DisagreeingVersionEvidence"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasEvidence"/>
          <owl:allValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#NonAgreeingVersionEvidence"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ContradictedClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every parseable source ({versionSourceCount}) disagrees with the claimed version</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#VersionSourcesConflict">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#VersionClaim"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasEvidence"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#AgreeingVersionEvidence"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasEvidence"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#DisagreeingVersionEvidence"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ConflictedClaim"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sources disagree with each other: some agree and some contradict the claimed version</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_versionSourceCount_ge_0_le_0">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#versionSourceCount"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{versionSourceCount} within [0, 0]</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#NoVersionSource">
  <owl:equivalentClass>
    <owl:Class>
