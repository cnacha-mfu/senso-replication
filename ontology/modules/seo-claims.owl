  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{claimSubject} does not resolve to a tracked path, so churn is not measured</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_pathSuffixMatchCount_ge_2">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#pathSuffixMatchCount"/>
