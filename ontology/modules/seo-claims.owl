<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://senso-framework.org/ontology/seo/seo-claims"
         xmlns="http://senso-framework.org/ontology/seo/seo-claims#"
         xmlns:seo="http://senso-framework.org/ontology/seo#">

<owl:Ontology rdf:about="http://senso-framework.org/ontology/seo/seo-claims">
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-entities"/>
  <rdfs:comment xml:lang="en">WP2 claim vocabulary and consistency verdicts. SWRL-free; imports seo-entities only.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#makesClaim">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestDocument"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#makesExcludedClaim">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestDocument"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasEvidence">
  <owl:inverseOf rdf:resource="http://senso-framework.org/ontology/seo#evidenceFor"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#evidenceFor">
  <owl:inverseOf rdf:resource="http://senso-framework.org/ontology/seo#hasEvidence"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#introducedAs">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#claimQuote">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Verbatim quote from the manifest (context). Unit: text. Computed by: wp2.consensus.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.consensus</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">text</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#claimSubject">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Normalized subject of the claim (context). Unit: text. Computed by: wp2.normalize.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.normalize</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">text</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#claimKey">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Canonical claim key (type, normalized subject, ...). Unit: text. Computed by: wp2.normalize.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.normalize</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">text</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#claimLine">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Global line number of the quote in the manifest. Unit: line. Computed by: wp2.consensus.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.consensus</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">line</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#extractionVotes">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Number of extraction models (1 to 3) that proposed this claim key. Unit: models. Computed by: wp2.consensus.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.consensus</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">models</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#snapshotCommit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Commit S at which the manifest and repository are examined. Unit: sha. Computed by: wp2.snapshot.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestDocument"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.snapshot</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sha</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#manifestPath">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Repository path of the manifest. Unit: path. Computed by: wp2.snapshot.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestDocument"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.snapshot</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">path</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathExactMatchCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Tracked files equal to the path, under the directory, or matching the glob at S. Unit: paths. Computed by: wp2.measure.path_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paths</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathSuffixMatchCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Tracked paths that end with '/' + path (monorepo-relative mentions). Unit: paths. Computed by: wp2.measure.path_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paths</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathIgnoredCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">1 if a .gitignore at S matches the path, else 0. Unit: 0/1. Computed by: wp2.measure.path_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0/1</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathSubmoduleCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">1 if a gitlink (mode 160000) is a prefix of the path, else 0. Unit: 0/1. Computed by: wp2.measure.path_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0/1</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathEverTrackedCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Commits up to S that touched the path. Unit: commits. Computed by: wp2.measure.path_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">commits</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#daysSincePathLastTracked">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Days between the last commit touching the path and S (context). Unit: days. Computed by: wp2.measure.path_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">days</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathCommitsIn90d">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Non-merge first-parent commits touching the path in the 90 days before S. Unit: commits. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">commits</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathCommitsIn180d">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Same for 180 days. Unit: commits. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">commits</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathCommitsIn365d">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Same for 365 days. Unit: commits. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">commits</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathLinesChangedIn90d">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Lines added plus deleted inside the path, 90 days before S. Unit: lines. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lines</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathLinesChangedIn180d">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Same for 180 days. Unit: lines. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lines</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#pathLinesChangedIn365d">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Same for 365 days. Unit: lines. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lines</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#repoCommitsIn180d">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Repository commits in the 180 days before S (context). Unit: commits. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">commits</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#daysSincePathLastChange">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Days since the path last changed before S (context). Unit: days. Computed by: wp2.measure.path_churn.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.path_churn</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">days</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#toolSignatureHitCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Tracked files, manifest keys and declared dependencies that match the tool's signature at S. Unit: signatures. Computed by: wp2.measure.tool_hits.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.tool_hits</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signatures</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#toolEcosystemAnchorCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Tracked ecosystem anchor files (package.json, pyproject.toml, ...) at S. Unit: files. Computed by: wp2.measure.tool_hits.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.tool_hits</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">files</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#competingToolSignatureCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Signature hits of competing tools of the same category and ecosystem. Unit: signatures. Computed by: wp2.measure.tool_hits.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.tool_hits</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signatures</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#dependencyExactMatchCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Declarations of the dependency (normalized name) across tracked manifests at S. Unit: declarations. Computed by: wp2.depparse.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.depparse</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">declarations</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#dependencySuffixMatchCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Declarations whose name matches after the last '/'. Unit: declarations. Computed by: wp2.depparse.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.depparse</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">declarations</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#dependencyManifestParsedCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Dependency manifests parsed at S. Unit: files. Computed by: wp2.depparse.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.depparse</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">files</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#claimedMajor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Major version written in the claim. Unit: major. Computed by: wp2.depparse.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.depparse</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">major</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#declaredLowerMajorDelta">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Lowest declared lower-bound major minus claimedMajor. Unit: major. Computed by: wp2.depparse.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.depparse</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">major</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#declaredUpperMajorDelta">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Highest declared upper-bound major minus claimedMajor; asserted only if bounded. Unit: major. Computed by: wp2.depparse.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.depparse</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">major</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#declaredUpperUnboundedCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">1 if some declaration has no upper bound. Unit: 0/1. Computed by: wp2.depparse.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.depparse</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0/1</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#scriptDefinedRootCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Definitions of the script/target in root package.json, composer.json or Makefile. Unit: definitions. Computed by: wp2.measure.script_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.script_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">definitions</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#scriptDefinedAnyCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Definitions anywhere in tracked package.json, composer.json, Makefile and *.mk files. Unit: definitions. Computed by: wp2.measure.script_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.script_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">definitions</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#scriptHostFileCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Tracked files that could define the script (package.json / composer.json / Makefile ...). Unit: files. Computed by: wp2.measure.script_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.script_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">files</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#dynamicTargetRuleCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Make pattern rules or targets containing $(...). Unit: rules. Computed by: wp2.measure.script_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.script_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rules</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#ciInvocationCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">CI configs at S invoking the script (context, triangulation). Unit: files. Computed by: wp2.measure.script_counts.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.script_counts</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">files</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#versionSourceCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Parseable version sources for the claim's subject at S. Unit: sources. Computed by: wp2.measure.version_evidence.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.version_evidence</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sources</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#versionLowerDelta">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Declared lower bound minus claimed version, truncated to the claim's precision. Unit: version code. Computed by: wp2.measure.version_evidence.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.version_evidence</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">version code</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#versionUpperDelta">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Declared upper bound minus claimed version; asserted only if bounded. Unit: version code. Computed by: wp2.measure.version_evidence.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.version_evidence</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">version code</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#versionUpperUnboundedCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">1 if the source has no upper bound. Unit: 0/1. Computed by: wp2.measure.version_evidence.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.version_evidence</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0/1</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#versionSourcePath">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Source file (context). Unit: path. Computed by: wp2.measure.version_evidence.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.version_evidence</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">path</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#versionSourceRaw">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Raw declared version (context). Unit: text. Computed by: wp2.measure.version_evidence.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.version_evidence</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">text</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#importFilesScanned">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Tracked source files scanned inside the claim's scope. Unit: files. Computed by: wp2.measure.import_edges.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.import_edges</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">files</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#forbiddenImportEdgeCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Import statements that reference the forbidden target. Unit: edges. Computed by: wp2.measure.import_edges.</rdfs:comment>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <seo:computedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2.measure.import_edges</seo:computedBy>
  <seo:measurementUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">edges</seo:measurementUnit>
</owl:DatatypeProperty>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ManifestDocument">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ManifestClaim">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ClaimEvidence">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#VersionEvidence">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ClaimEvidence"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#PathExistenceClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#PathStatusClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#InactiveStatusClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#PathStatusClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ProtectedStatusClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ToolUsageClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#PackageManagerClaim">
  <owl:disjointWith rdf:resource="http://senso-framework.org/ontology/seo#NonPackageManagerToolClaim"/>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ToolUsageClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#NonPackageManagerToolClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#NoCompetingPackageManagerEvidence"/>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ToolUsageClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#DependencyClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#UnversionedDependencyClaim">
  <owl:disjointWith rdf:resource="http://senso-framework.org/ontology/seo#VersionedDependencyClaim"/>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#DependencyClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#VersionedDependencyClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#DependencyClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#CommandClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#VersionClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#MinVersionClaim">
  <owl:disjointWith rdf:resource="http://senso-framework.org/ontology/seo#ExactVersionClaim"/>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#VersionClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ExactVersionClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#VersionClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ImportConstraintClaim">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ManifestClaim"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_extractionVotes_ge_wp2_consensus_min_votes">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#extractionVotes"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{extractionVotes} &gt;= 2</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2_consensus_min_votes</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/wp2-design.md section 5.4</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#CheckedClaim">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ManifestClaim"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_extractionVotes_ge_wp2_consensus_min_votes"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extracted by {extractionVotes} models (consensus threshold)</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2_consensus_min_votes</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/wp2-design.md section 5.4</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_pathExactMatchCount_ge_0_le_0">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#pathExactMatchCount"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{pathExactMatchCount} within [0, 0]</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_pathSuffixMatchCount_ge_0_le_0">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#pathSuffixMatchCount"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
