</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_pathCommitsIn180d_le_wp2_inactive_support_max_commits">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#pathCommitsIn180d"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{pathCommitsIn180d} &lt;= 1</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wp2_inactive_support_max_commits</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/wp2-design.md section 3 (T2)</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#InactivePathQuiet">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
