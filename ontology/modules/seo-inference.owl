  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/rq1-preregistration.md section 2.2</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#MinorLocGrowth">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_locRelSenSlopeAnnual_lt_rb_min_rel_loc_growth_per_year"/>
