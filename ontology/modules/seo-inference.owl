    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#NonSubstantialChange"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">net LOC growth of only {locRelSenSlopeAnnual} of median size per year (Sen slope)</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rb_min_rel_loc_growth_per_year</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/rq1-preregistration.md section 2.2</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#NonSubstantialChange">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no significant LOC growth, or growth below the substantial-growth rate</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_alpha</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_min_months</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rb_min_rel_loc_growth_per_year</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:101,545</seo:thresholdSource>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:533</seo:thresholdSource>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/rq1-preregistration.md section 2.2</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#RBPhaseOutStage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Dormant"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phase-out: no commit for {monthsSinceLastCommit} months</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rb_dormancy_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/rq1-preregistration.md section 2.2</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#RBActiveDevelopmentStage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#RecentlyActive"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#GrowthStage"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SubstantialLocGrowth"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active development: recent commits, significant LOC growth (tau = {locMKTau}, p = {locMKpValue}) of {locRelSenSlopeAnnual} of median size per year</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_alpha</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_min_months</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rb_dormancy_months</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rb_min_rel_loc_growth_per_year</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:101,545</seo:thresholdSource>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:533</seo:thresholdSource>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/rq1-preregistration.md section 2.2</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#RBServicingStage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
