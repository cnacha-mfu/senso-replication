<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://senso-framework.org/ontology/seo/seo-inference"
         xmlns="http://senso-framework.org/ontology/seo/seo-inference#"
         xmlns:seo="http://senso-framework.org/ontology/seo#">

<owl:Ontology rdf:about="http://senso-framework.org/ontology/seo/seo-inference">
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-entities"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-laws"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-metrics"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-patterns"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-processes"/>
</owl:Ontology>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_locSeriesLength_ge_mk_min_months">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#locSeriesLength"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{locSeriesLength} &gt;= 4</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_min_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:533</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#MKApplicable">
  <owl:equivalentClass rdf:resource="http://senso-framework.org/ontology/seo#A_locSeriesLength_ge_mk_min_months"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{locSeriesLength} months of LOC</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_min_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:533</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_locMKpValue_lt_mk_alpha">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#locMKpValue"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.05</xsd:maxExclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{locMKpValue} &lt; 0.05</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_alpha</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:101,545</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_locMKpValue_ge_mk_alpha">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#locMKpValue"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.05</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{locMKpValue} &gt;= 0.05</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_alpha</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:101,545</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_locMKTau_gt_0">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#locMKTau"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minExclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{locMKTau} &gt; 0</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_locMKTau_lt_0">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#locMKTau"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:maxExclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{locMKTau} &lt; 0</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#GrowthStage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#MKApplicable"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_locMKpValue_lt_mk_alpha"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_locMKTau_gt_0"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#LawVIConformant"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">significant growing LOC trend (Mann-Kendall tau = {locMKTau}, p = {locMKpValue}, {locSeriesLength} months)</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_alpha</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_min_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:101,545</seo:thresholdSource>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:533</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#DeclineStage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#MKApplicable"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_locMKpValue_lt_mk_alpha"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_locMKTau_lt_0"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#NonSubstantialChange"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">significant shrinking LOC trend (Mann-Kendall tau = {locMKTau}, p = {locMKpValue}, {locSeriesLength} months)</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_alpha</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_min_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:101,545</seo:thresholdSource>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:533</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#StabilizationStage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#MKApplicable"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_locMKpValue_ge_mk_alpha"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#LawVIConformant"/>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#NonSubstantialChange"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no significant LOC trend (Mann-Kendall tau = {locMKTau}, p = {locMKpValue}, {locSeriesLength} months)</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_alpha</seo:thresholdId>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mk_min_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:101,545</seo:thresholdSource>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/population/populate.py:533</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_monthsSinceLastCommit_ge_rb_dormancy_months">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#monthsSinceLastCommit"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{monthsSinceLastCommit} &gt;= 12</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rb_dormancy_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/rq1-preregistration.md section 2.2</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#Dormant">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#A_monthsSinceLastCommit_ge_rb_dormancy_months"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no commit for {monthsSinceLastCommit} months</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rb_dormancy_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">papers/paper1/rq1-preregistration.md section 2.2</seo:thresholdSource>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_monthsSinceLastCommit_lt_rb_dormancy_months">
