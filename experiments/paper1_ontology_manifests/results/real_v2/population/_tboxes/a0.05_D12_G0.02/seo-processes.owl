<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://senso-framework.org/ontology/seo/seo-processes"
         xmlns="http://senso-framework.org/ontology/seo/seo-processes#">

<owl:Ontology rdf:about="http://senso-framework.org/ontology/seo/seo-processes">
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-entities"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#experiencesPhase">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#GrowthPhase"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#StabilizationPhase"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#DeclinePhase"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#AgentAssistedPhase"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasChange">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#EvolutionEpisode"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#Commit"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#RefactoringEvent"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ArchitecturalChange"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#hasRefactoring">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#RefactoringEvent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#occursIn">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#EvolutionEpisode"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#RefactoringEvent"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ArchitecturalChange"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
</owl:ObjectProperty>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#EvolutionEpisode">
  <rdfs:comment xml:lang="en">Paper 1 — groups related changes.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#EvolutionPhase">
  <rdfs:comment xml:lang="en">Paper 1 — base class for evolution phases.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#GrowthPhase">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#EvolutionPhase"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#StabilizationPhase">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#EvolutionPhase"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#DeclinePhase">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#EvolutionPhase"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ChangeEvent">
  <rdfs:comment xml:lang="en">Paper 1 — base class for change events.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#RefactoringEvent">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ChangeEvent"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#ArchitecturalChange">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ChangeEvent"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#AgentAssistedPhase">
  <rdfs:comment xml:lang="en">Paper 1 — agent-aware evolution phase.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#EvolutionPhase"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#AgentAdoptionEvent">
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#ChangeEvent"/>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#RefactoringEvent"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ArchitecturalChange"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#AgentAdoptionEvent"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#GrowthPhase"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#StabilizationPhase"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#DeclinePhase"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#AgentAssistedPhase"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#EvolutionEpisode"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#EvolutionPhase"/>
    <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#ChangeEvent"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
