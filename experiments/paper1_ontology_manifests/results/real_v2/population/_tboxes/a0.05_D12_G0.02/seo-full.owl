<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://senso-framework.org/ontology/seo/seo-full"
         xmlns="http://senso-framework.org/ontology/seo/seo-full#">

<owl:Ontology rdf:about="http://senso-framework.org/ontology/seo/seo-full">
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-entities"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-evidence"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-inference"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-laws"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-metrics"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-patterns"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-processes"/>
  <rdfs:comment xml:lang="en">Imports closure of the canonical SEO modules (entities .. inference). seo-legacy.owl is a regression artefact and is deliberately not imported.</rdfs:comment>
</owl:Ontology>


</rdf:RDF>
