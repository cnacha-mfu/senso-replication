    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasMonth"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#A_commitDeltaFromPrev_gt_0"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://senso-framework.org/ontology/seo#LegacyNoDeclineOverride"/>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_commitHalfRatio_lt_e_decl_ratio">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#commitHalfRatio"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
