  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#CommitsMonotoneNonIncreasing">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#SoftwareProject"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasMonth"/>
          <owl:allValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#CommitNonIncreaseOrFirstMonth"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#hasMonth"/>
          <owl:someValuesFrom rdf:resource="http://senso-framework.org/ontology/seo#MonthSnapshot"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">commits never increase month on month</seo:explanationTemplate>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#CommitsNotMonotone">
