<owl:Class rdf:about="http://senso-framework.org/ontology/seo#A_monthsObserved_ge_e_min_months">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://senso-framework.org/ontology/seo#monthsObserved"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <seo:explanationTemplate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{monthsObserved} &gt;= 2</seo:explanationTemplate>
  <seo:thresholdId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">e_min_months</seo:thresholdId>
  <seo:thresholdSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology/scenario_bank/test_scenarios.py:98</seo:thresholdSource>
</owl:Class>

