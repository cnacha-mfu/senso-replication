<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://senso-framework.org/ontology/seo/seo-laws"
         xmlns="http://senso-framework.org/ontology/seo/seo-laws#">

<owl:Ontology rdf:about="http://senso-framework.org/ontology/seo/seo-laws">
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-entities"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-metrics"/>
  <owl:imports rdf:resource="http://senso-framework.org/ontology/seo/seo-processes"/>
  <rdfs:comment xml:lang="en">Law individuals only. The conformance rules live in seo-inference.owl (canonical, pipeline thresholds) and seo-legacy.owl (paper-table variant).</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#conformsToLaw">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#LawConformance"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#violatesLaw">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#LawViolation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#lawType">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#LawConformance"/>
        <rdf:Description rdf:about="http://senso-framework.org/ontology/seo#LawViolation"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://senso-framework.org/ontology/seo#succeeds">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
  <rdfs:range rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#usedInRealWorld">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#activeDevelopment">
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#SoftwareProject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#qualityScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#growthRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#workRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Version"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://senso-framework.org/ontology/seo#incrementalGrowth">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://senso-framework.org/ontology/seo#Release"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#LehmanLaw">
  <rdfs:comment xml:lang="en">Paper 1 — formal representation of Lehman's laws.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#LawConformance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://senso-framework.org/ontology/seo#LawViolation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawI_ContinuingChange">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">A program used in a real-world environment must be continually adapted, else it becomes progressively less satisfactory.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawII_IncreasingComplexity">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">As a program evolves, its complexity increases unless work is done to maintain or reduce it.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawIII_SelfRegulation">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">The evolution process is self-regulating with statistically determinable trends and invariances.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawIV_ConservationOfOrgStability">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">The average effective global activity rate on an evolving system is approximately constant over its lifetime.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawV_ConservationOfFamiliarity">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">The average incremental growth per release tends to remain constant or decline over a system's lifetime.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawVI_ContinuingGrowth">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">The functional content of a system must be continually increased to maintain user satisfaction.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawVII_DecliningQuality">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">The quality of a system will appear to be declining unless it is rigorously maintained and adapted.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://senso-framework.org/ontology/seo#LawVIII_FeedbackSystem">
  <rdf:type rdf:resource="http://senso-framework.org/ontology/seo#LehmanLaw"/>
  <rdfs:comment xml:lang="en">Evolution processes are multi-level, multi-loop, multi-agent feedback systems.</rdfs:comment>
</owl:NamedIndividual>


</rdf:RDF>
