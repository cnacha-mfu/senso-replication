<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="http://senso-framework.org/ontology/seo#Commit"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
        </swrl:ClassAtom>
